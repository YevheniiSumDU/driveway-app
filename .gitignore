# ============================================================
# Angular + Node.js .gitignore
# ============================================================

# --- Build output ---
/dist
/tmp
/out-tsc
/bazel-out

# --- Dependencies ---
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment files ---
# Never commit secrets or environment configuration
.env
.env.local
.env.*.local

# --- IDEs and Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# --- Local History / Logs ---
.history/
logs/
*.log
/libpeerconnection.log
testem.log

# --- Coverage / Test outputs ---
/coverage
/.angular/cache
/.nyc_output
/typings

# --- Sass / Cache files ---
.sass-cache/
.connect.lock

# --- System Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Cypress ---
/cypress/videos
/cypress/screenshots
/cypress/downloads

# --- Misc ---
/*.tgz
*.swp
*.tmp
*.bak
*.old
